<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TikAuto" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/cyan_deep</item>
        <item name="colorPrimaryVariant">@color/brand</item>
        <item name="colorSecondary">@color/coral</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="android:statusBarColor">@color/bg_top</item>
        <item name="android:navigationBarColor">@color/bg_bottom</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@drawable/bg_atmosphere</item>
        <item name="fontFamily">@font/outfit_regular</item>
        <item name="android:fontFamily">@font/outfit_regular</item>
    </style>

    <style name="TikAuto.Brand" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:fontFamily">@font/outfit_bold</item>
        <item name="fontFamily">@font/outfit_bold</item>
        <item name="android:textColor">@color/brand</item>
        <item name="android:textSize">42sp</item>
        <item name="android:letterSpacing">-0.03</item>
    </style>

    <style name="TikAuto.Section" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:fontFamily">@font/outfit_semibold</item>
        <item name="fontFamily">@font/outfit_semibold</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="TikAuto.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">@font/outfit_regular</item>
        <item name="fontFamily">@font/outfit_regular</item>
        <item name="android:textColor">@color/ink_soft</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.25</item>
    </style>

    <style name="TikAuto.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:fontFamily">@font/outfit_semibold</item>
        <item name="fontFamily">@font/outfit_semibold</item>
        <item name="cornerRadius">14dp</item>
        <item name="backgroundTint">@color/brand</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minHeight">52dp</item>
    </style>

    <style name="TikAuto.Button.Cyan" parent="TikAuto.Button">
        <item name="backgroundTint">@color/cyan_deep</item>
    </style>

    <style name="TikAuto.Button.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:fontFamily">@font/outfit_semibold</item>
        <item name="fontFamily">@font/outfit_semibold</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeColor">@color/ink</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
    </style>
</resources>
